<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<profiles version="21">
  <profile kind="CodeFormatterProfile" name="nvim-4space" version="21">
    <!-- 4-space indentation, spaces not tabs -->
    <setting id="org.eclipse.jdt.core.formatter.tabulation.char" value="space"/>
    <setting id="org.eclipse.jdt.core.formatter.tabulation.size" value="4"/>
    <setting id="org.eclipse.jdt.core.formatter.indentation.size" value="4"/>
    <!-- wrapped/continuation lines get 1x indent (4 spaces), not the default 2x (8) -->
    <setting id="org.eclipse.jdt.core.formatter.continuation_indentation" value="1"/>
    <setting id="org.eclipse.jdt.core.formatter.continuation_indentation_for_array_initializer" value="1"/>
    <!-- one record component per line (M_ONE_PER_LINE_SPLIT = 48); annotations stay
         inline with the component. NOTE: jdtls shares annotation-wrapping settings
         between record components and method parameters, so splitting each annotation
         onto its own line for records would also mangle annotated method params
         (e.g. @RequestBody @Valid in controllers), so we keep annotations compact. -->
    <setting id="org.eclipse.jdt.core.formatter.alignment_for_record_components" value="48"/>
  </profile>
</profiles>
